# Build-time settings for the website (Vite inlines VITE_* values into the built JavaScript, so changing one needs a
# rebuild and redeploy). Copy to .env.local for local work (git-ignored). Never commit a real value.
#
# EVERYTHING HERE ENDS UP IN PUBLIC JAVASCRIPT AND THE BROWSER'S NETWORK TAB. Do not put a real secret in a VITE_*
# variable.

# RenalTracker waitlist form (renaltracker/waitlist.js). The form stays hidden, and the "Waitlist opening soon"
# fallback shows, unless BOTH of these are set. Production URL (pod_processor on Railway):
#   VITE_WAITLIST_URL=https://podprocessor-production.up.railway.app/public/waitlist
VITE_WAITLIST_URL=

# Shared token sent as "Authorization: Bearer <token>". It must equal WAITLIST_API_TOKEN on the API. It is NOT a
# strong secret (anyone can read it from the page); it only stops casual scripts and curl callers who have not opened
# the page. Rotate it by changing both values and redeploying both. The API's per-IP limit is the real backstop.
VITE_WAITLIST_TOKEN=

# Our own Stripe Checkout (src/checkout.js; replaces Zylvie, see docs/stripe-checkout-design.md). Base URL of
# pod_processor, no trailing slash. While this is EMPTY, every buy button keeps its Zylvie link and the thank-you
# page keeps its old Zylvie behavior, so the site can be built and deployed safely before checkout goes live.
#   VITE_CHECKOUT_API_URL=https://podprocessor-production.up.railway.app
# Local demo: VITE_CHECKOUT_API_URL=http://localhost:8000
VITE_CHECKOUT_API_URL=
